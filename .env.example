# Required
DATABASE_URL=postgresql://user:password@localhost:5432/investalo
SESSION_SECRET=replace-with-a-random-string-of-32-plus-characters

# Authentication: set both for Google sign-in, or use DEV_MODE locally
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL for the OAuth callback (defaults to RAILWAY_PUBLIC_DOMAIN, then http://localhost:5000)
APP_URL=
# DEV_MODE=true signs every request in as a local test user. Never enable in production.
DEV_MODE=
# Optional password gate for DEV_MODE deployments (seeded into the database on first start)
DEV_PASSWORD=

# Claude features: listing import, investment and market analysis
ANTHROPIC_API_KEY=
# Model for all Claude features (default: claude-haiku-5-5). Must support the effort
# parameter (Claude Haiku 5.5 or a current Sonnet/Opus); Claude Haiku 4.5 does not.
CLAUDE_MODEL=
# Set to false to hide the Claude features entirely
CLAUDE_FEATURES=

PORT=5000
